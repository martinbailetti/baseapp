# Nombre de la aplicación (usado en LoginPage, QrConfirmPage, etc.)
VITE_APP_NAME=BaseKit

# Configuración de Keycloak
VITE_KEYCLOAK_URL=http://192.168.13.162:8080
VITE_KEYCLOAK_REALM=MyRealm
VITE_KEYCLOAK_CLIENT_ID=basekit

# Roles requeridos para acceder a la app (separados por comas, vacío = sin restricción)
# TEMPORALMENTE DESACTIVADO para debugging de CORS
VITE_REQUIRED_ROLES=super,admin,viewer

# URL base de BaseKit API
# Vacío = usa paths relativos con proxy de Vite (ver vite.config.js)
VITE_API_URL=

# smi_msg WebSocket
VITE_SMI_MSG_WS_URL=wss://192.168.13.162:3008
VITE_APP_TOKEN=basekit

# Mostrar página de gestión de usuarios (requiere KEYCLOAK_API_CLIENT_ID/SECRET en el backend)
VITE_ENABLE_USERS_PAGE=true

# Mostrar banner de instalación PWA (solo en dispositivos móviles)
VITE_ENABLE_INSTALL_PROMPT=true

VITE_SVN_URL=svn://xxx.org/WebProjects/BaseKit